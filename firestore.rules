rules_version = '2';

// Jeder Account sieht und bearbeitet ausschliesslich seine eigenen Daten unter users/{uid}.
// Zusätzlich sind nur die Sammlungen und Felder erlaubt, die die App tatsächlich benutzt,
// mit Typ- und Grössengrenzen – so lässt sich die Datenbank nicht als beliebiger Speicher missbrauchen.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ---------- Typ-Helfer ----------
    function str(v, max) { return v is string && v.size() <= max; }
    function optStr(v, max) { return v == null || str(v, max); }
    function num(v) { return v is int || v is float; }
    function optNum(v) { return v == null || num(v); }
    function idList(v) { return v is list && v.size() <= 50; }
    function color(v) { return v == null || (v is string && v.matches('^[a-z]{1,16}$')); }

    // ---------- Gültige Dokumente pro Sammlung ----------
    function validNode(d) {
      return d.keys().hasOnly(['type', 'parentId', 'title', 'order', 'icon', 'color', 'createdAt', 'updatedAt'])
        && d.type in ['folder', 'note']
        && optStr(d.get('parentId', null), 64)
        && str(d.get('title', ''), 300)
        && num(d.get('order', 0))
        && optStr(d.get('icon', null), 16)
        && color(d.get('color', null))
        && optNum(d.get('createdAt', null))
        && optNum(d.get('updatedAt', null));
    }

    // Notizinhalt als JSON-Text (Firestore begrenzt ein Dokument ohnehin auf 1 MiB)
    function validContent(d) {
      return d.keys().hasOnly(['json', 'updatedAt'])
        && optStr(d.get('json', null), 1000000)
        && optNum(d.get('updatedAt', null));
    }

    // Bilder: nur Daten-URLs von Bildern, im Browser auf ca. 700 KB verkleinert
    function validAsset(d) {
      return d.keys().hasOnly(['data', 'createdAt'])
        && str(d.data, 1000000)
        && d.data.matches('^data:image/(webp|png|jpeg|gif);base64,.*')
        && optNum(d.get('createdAt', null));
    }

    function validEvent(d) {
      return d.keys().hasOnly(['title', 'color', 'allDay', 'start', 'end', 'location', 'notes', 'repeat',
                               'repeatUntil', 'tagIds', 'createdAt', 'updatedAt',
                               // Felder aus der früheren Erinnerungs-Version, damit alte Termine bearbeitbar bleiben
                               'reminders', 'tz', 'nextReminderAt'])
        && str(d.get('title', ''), 300)
        && color(d.get('color', null))
        && d.get('allDay', false) is bool
        && num(d.start) && num(d.end)
        && str(d.get('location', ''), 300)
        && str(d.get('notes', ''), 10000)
        && d.get('repeat', 'none') in ['none', 'daily', 'weekly', 'monthly', 'yearly']
        && optNum(d.get('repeatUntil', null))
        && idList(d.get('tagIds', []))
        && optNum(d.get('createdAt', null))
        && optNum(d.get('updatedAt', null));
    }

    function validTodo(d) {
      return d.keys().hasOnly(['title', 'notes', 'done', 'doneAt', 'priority', 'urgency', 'due', 'tagIds',
                               'createdAt', 'updatedAt'])
        && str(d.get('title', ''), 500)
        && str(d.get('notes', ''), 10000)
        && d.get('done', false) is bool
        && optNum(d.get('doneAt', null))
        && d.get('priority', 0) in [0, 1, 2, 3]
        && d.get('urgency', 0) in [0, 1, 2, 3]
        && optNum(d.get('due', null))
        && idList(d.get('tagIds', []))
        && optNum(d.get('createdAt', null))
        && optNum(d.get('updatedAt', null));
    }

    function validTag(d) {
      return d.keys().hasOnly(['name', 'color', 'createdAt', 'updatedAt'])
        && str(d.name, 60)
        && color(d.get('color', null))
        && optNum(d.get('createdAt', null))
        && optNum(d.get('updatedAt', null));
    }

    function validPrefs(d) {
      // defaultReminders stammt aus der früheren Erinnerungs-Version
      return d.keys().hasOnly(['theme', 'lang', 'defaultReminders'])
        && d.get('theme', 'system') in ['light', 'dark', 'system']
        && d.get('lang', 'de') in ['de', 'en'];
    }

    function validDoc(collection, docId, d) {
      return (collection == 'nodes' && validNode(d))
        || (collection == 'contents' && validContent(d))
        || (collection == 'assets' && validAsset(d))
        || (collection == 'events' && validEvent(d))
        || (collection == 'todos' && validTodo(d))
        || (collection == 'tags' && validTag(d))
        || (collection == 'settings' && docId == 'prefs' && validPrefs(d));
    }

    match /users/{uid}/{collection}/{docId} {
      allow read, delete: if isOwner(uid)
        && collection in ['nodes', 'contents', 'assets', 'events', 'todos', 'tags', 'settings'];
      allow create, update: if isOwner(uid)
        && docId.size() <= 64
        && validDoc(collection, docId, request.resource.data);
    }

    // Alles andere ist gesperrt
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
