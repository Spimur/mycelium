# Kopiere diese Datei nach ".env.local" und trage die Werte aus der Firebase-Konsole ein
# (Projekteinstellungen -> Allgemein -> Deine Apps -> Web-App -> SDK-Konfiguration).
# Ohne diese Werte läuft Mycelium im lokalen Modus (Daten nur in diesem Browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Angaben für Impressum und Datenschutzerklärung (Pflicht für einen öffentlichen Betrieb mit Accounts).
# Sie erscheinen öffentlich auf der Website, gehören aber nicht ins Repository.
VITE_LEGAL_NAME=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_EMAIL=
