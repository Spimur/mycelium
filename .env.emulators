# Konfiguration für die lokalen Firebase-Emulatoren (npm run emulators + npm run dev:emulators).
# "demo-" Projekte existieren nur lokal, es wird nichts an Google gesendet.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-mycelium
VITE_FIREBASE_APP_ID=demo-app
VITE_USE_EMULATORS=true
